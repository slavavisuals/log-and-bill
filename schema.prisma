generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_userId_user_id_fk")

  @@id([provider, providerAccountId], map: "account_provider_providerAccountId_pk")
}

model Cart {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @db.Uuid
  sessionCartId String
  items         Json[]   @default([]) @db.Json
  itemsPrice    Decimal  @db.Decimal(12, 2)
  shippingPrice Decimal  @db.Decimal(12, 2)
  taxPrice      Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  User          User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_userId_user_id_fk")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @db.Uuid
  shippingAddress Json        @db.Json
  paymentMethod   String
  paymentResult   Json?       @db.Json
  itemsPrice      Decimal     @db.Decimal(12, 2)
  shippingPrice   Decimal     @db.Decimal(12, 2)
  taxPrice        Decimal     @db.Decimal(12, 2)
  totalPrice      Decimal     @db.Decimal(12, 2)
  isPaid          Boolean     @default(false)
  paidAt          DateTime?   @db.Timestamp(6)
  isDelivered     Boolean     @default(false)
  deliveredAt     DateTime?   @db.Timestamp(6)
  createdAt       DateTime    @default(now()) @db.Timestamp(6)
  User            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_userId_user_id_fk")
  OrderItem       OrderItem[]
}

model OrderItem {
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  qty       Int
  price     Decimal @db.Decimal(12, 2)
  name      String
  slug      String
  image     String
  Order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderItems_orderId_order_id_fk")
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderItems_productId_product_id_fk")

  @@id([orderId, productId], map: "orderItems_orderId_productId_pk")
}

model Product {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String      @unique(map: "product_slug_idx")
  category    String
  images      String[]
  brand       String
  description String
  stock       Int
  price       Decimal     @default(0) @db.Decimal(12, 2)
  rating      Decimal     @default(0) @db.Decimal(3, 2)
  numReviews  Int         @default(0)
  isFeatured  Boolean     @default(false)
  banner      String?
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  OrderItem   OrderItem[]
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_userId_user_id_fk")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("NO_NAME")
  email         String    @unique(map: "user_email_idx")
  emailVerified DateTime? @db.Timestamp(6)
  image         String?
  password      String?
  role          String    @default("user")
  address       Json?     @db.Json
  paymentMethod String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime
  Account       Account[]
  Cart          Cart[]
  Order         Order[]
  Session       Session[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model akiya_properties {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id          String    @unique @db.VarChar(255)
  price                String?
  room_type            String?
  year_of_construction String?
  serial_number        String?
  no_of_floors         Int?
  contact_info         String?
  area_of_house        String?
  area_of_land         String?
  address              String?
  coordinates          Json?
  link_to_website      String?
  images               Json?
  region               String?
  prefecture           String?
  municipality         String?
  page_url             String?
  scraped_at           DateTime? @default(now()) @db.Timestamptz(6)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  @@index([coordinates], map: "idx_akiya_coordinates", type: Gin)
  @@index([images], map: "idx_akiya_images", type: Gin)
  @@index([municipality], map: "idx_akiya_municipality")
  @@index([prefecture], map: "idx_akiya_prefecture")
  @@index([property_id], map: "idx_akiya_property_id")
  @@index([region], map: "idx_akiya_region")
  @@index([scraped_at(sort: Desc)], map: "idx_akiya_scraped_at")
}

model contacts {
  id         Int       @id @default(autoincrement())
  first_name String    @db.VarChar(100)
  last_name  String    @db.VarChar(100)
  email      String    @unique @db.VarChar(255)
  date_added DateTime? @default(now()) @db.Timestamptz(6)
}

model documents {
  id        BigInt                 @id @default(autoincrement())
  content   String
  metadata  Json?                  @default("{}")
  embedding Unsupported("vector")?

  @@index([embedding])
  @@index([metadata], map: "idx_documents_metadata", type: Gin)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model listing_images {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  listing_id  String
  full_url    String
  alt         String?
  height      Int?
  width       Int?
  image_order Int?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  listings    listings  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([listing_id, full_url])
  @@index([listing_id], map: "idx_listing_images_listing_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model listings {
  id                 String           @id
  page_title         String
  area_building      Decimal?         @db.Decimal(10, 2)
  area_land          Decimal?         @db.Decimal(10, 2)
  latitude           Decimal?         @db.Decimal(10, 7)
  longitude          Decimal?         @db.Decimal(10, 7)
  date_built         DateTime?        @db.Date
  layout             String?
  price              Int?
  source_name        String?
  source_url         String?
  source_date_listed DateTime?        @db.Date
  summary            String?
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?        @default(now()) @db.Timestamptz(6)
  listing_images     listing_images[]

  @@index([created_at], map: "idx_listings_created_at")
  @@index([price], map: "idx_listings_price")
  @@index([updated_at], map: "idx_listings_updated_at")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

// ============================================
// LOG AND BILL - Time Tracking Application
// ============================================

model log_and_bill_users {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId   String   @unique @db.VarChar(255) // Clerk user ID
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  settings   log_and_bill_user_settings?
  projects   log_and_bill_projects[]
  clients    log_and_bill_clients[]
  activities log_and_bill_activities[]
  tags       log_and_bill_tags[]
  invoices   log_and_bill_invoices[]

  @@index([clerkId], map: "idx_lab_users_clerk_id")
  @@index([email], map: "idx_lab_users_email")
}

model log_and_bill_user_settings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @db.Uuid
  weeklyHourLimit       Decimal? @db.Decimal(5, 2) // e.g., 40.00 hours
  monthlyHourLimit      Decimal? @db.Decimal(6, 2) // e.g., 160.00 hours
  defaultHourlyRate     Decimal  @default(0) @db.Decimal(10, 2)
  currency              String   @default("USD") @db.VarChar(3)
  timeFormat            String   @default("24h") @db.VarChar(3) // "12h" or "24h"
  newProjectsBillable   Boolean  @default(true)
  companyName           String?  @db.VarChar(255)
  companyAddress        String?  @db.Text
  payToDetails          String?  @db.Text // Payment instructions for invoices
  defaultTaxType        String?  @db.VarChar(20) // GST, HST, VAT, etc.
  defaultTaxRate        Decimal? @db.Decimal(5, 2) // e.g., 13.00 for 13%
  createdAt             DateTime @default(now()) @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @db.Timestamp(6)

  user log_and_bill_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_lab_user_settings_user_id")
}

model log_and_bill_clients {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  name      String    @db.VarChar(255)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  address   String?   @db.Text
  notes     String?   @db.Text
  color     String?   @db.VarChar(7) // Hex color for UI
  isDeleted Boolean   @default(false) // Soft delete
  deletedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)

  user     log_and_bill_users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects log_and_bill_projects[]
  invoices log_and_bill_invoices[]

  @@index([userId], map: "idx_lab_clients_user_id")
  @@index([userId, isDeleted], map: "idx_lab_clients_user_active")
}

model log_and_bill_projects {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  clientId   String?   @db.Uuid
  name       String    @db.VarChar(255)
  color      String?   @db.VarChar(7) // Hex color for UI
  hourlyRate Decimal?  @db.Decimal(10, 2) // Override user's default rate
  isBillable Boolean   @default(true)
  isDeleted  Boolean   @default(false) // Soft delete
  deletedAt  DateTime? @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt @db.Timestamp(6)

  user       log_and_bill_users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     log_and_bill_clients?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  activities log_and_bill_activities[]

  @@index([userId], map: "idx_lab_projects_user_id")
  @@index([userId, isDeleted], map: "idx_lab_projects_user_active")
  @@index([clientId], map: "idx_lab_projects_client_id")
}

model log_and_bill_tags {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(50) // Max 50 chars, truncate display at 8
  color     String?  @db.VarChar(7) // Hex color for UI
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  user       log_and_bill_users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities log_and_bill_activity_tags[]

  @@unique([userId, name], map: "idx_lab_tags_user_name_unique")
  @@index([userId], map: "idx_lab_tags_user_id")
}

model log_and_bill_activities {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  projectId   String?  @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  startTime   DateTime @db.Timestamp(6)
  endTime     DateTime @db.Timestamp(6)
  duration    Int      // Duration in minutes (calculated)
  isBillable  Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  user    log_and_bill_users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project log_and_bill_projects?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags    log_and_bill_activity_tags[]

  @@index([userId], map: "idx_lab_activities_user_id")
  @@index([userId, startTime], map: "idx_lab_activities_user_start")
  @@index([projectId], map: "idx_lab_activities_project_id")
  @@index([startTime, endTime], map: "idx_lab_activities_time_range")
}

model log_and_bill_activity_tags {
  activityId String @db.Uuid
  tagId      String @db.Uuid

  activity log_and_bill_activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag      log_and_bill_tags       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId], map: "lab_activity_tags_pk")
  @@index([activityId], map: "idx_lab_activity_tags_activity")
  @@index([tagId], map: "idx_lab_activity_tags_tag")
}

model log_and_bill_invoices {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  clientId      String?   @db.Uuid
  invoiceNumber String    @db.VarChar(50)
  invoiceDate   DateTime  @db.Date
  dueDate       DateTime? @db.Date
  billedTo      String?   @db.Text // Client billing address
  payTo         String?   @db.Text // Payment details
  taxType       String?   @db.VarChar(20)
  taxRate       Decimal?  @db.Decimal(5, 2)
  currency      String    @default("USD") @db.VarChar(3)
  subtotal      Decimal   @db.Decimal(12, 2)
  taxAmount     Decimal   @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  status        String    @default("draft") @db.VarChar(20) // draft, sent, paid
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @db.Timestamp(6)

  user   log_and_bill_users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client log_and_bill_clients?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items  log_and_bill_invoice_items[]

  @@unique([userId, invoiceNumber], map: "idx_lab_invoices_user_number_unique")
  @@index([userId], map: "idx_lab_invoices_user_id")
  @@index([clientId], map: "idx_lab_invoices_client_id")
  @@index([invoiceDate], map: "idx_lab_invoices_date")
}

model log_and_bill_invoice_items {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @db.Uuid
  date        DateTime @db.Date
  description String   @db.VarChar(255)
  hours       Decimal  @db.Decimal(6, 2)
  rate        Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  invoice log_and_bill_invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_lab_invoice_items_invoice_id")
}
